# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados
# do projeto no Supabase: Project Settings -> Database -> Connection
# parameters. O .env NÃO deve ser commitado (já está no .gitignore) —
# cada pessoa da dupla usa o mesmo .env, apontando para o mesmo projeto
# Supabase, mas mantém o arquivo só na própria máquina.

# Use a "Direct connection" (não a de "Connection pooling") — mais simples
# e sem as limitações do PgBouncer para o uso do projeto.
DB_NAME=postgres
DB_USER=postgres
DB_PASSWORD=
DB_HOST=db.xxxxxxxxxxxxxxxxxxxx.supabase.co
DB_PORT=5432
