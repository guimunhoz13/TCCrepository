# Copie este arquivo para ".env" (mesma pasta) e preencha com os dados
# do projeto no Supabase: Project Settings -> Database -> Connect.
# O .env NÃO deve ser commitado (já está no .gitignore) — cada pessoa da
# dupla usa o mesmo .env, apontando para o mesmo projeto Supabase, mas
# mantém o arquivo só na própria máquina.

# Ao criar o projeto no Supabase, escolha a região "South America
# (São Paulo)" — uma região distante (ex.: EUA) adiciona latência em
# toda consulta e deixa o site perceptivelmente lento.
#
# A maioria das redes (e o Supabase por padrão) só oferece IPv4 para a
# "Direct connection", então normalmente é preciso usar o pooler
# (Supavisor). Use o modo "Session" (porta 5432), NÃO o "Transaction"
# (porta 6543): o Django reaproveita a mesma conexão entre requests
# (CONN_MAX_AGE, ver core/settings.py) para não ficar lento, e o modo
# Transaction não suporta bem conexões reaproveitadas/de longa duração.
# HOST e USER abaixo vêm do painel "Connect" > "Session pooler".
DB_NAME=postgres
DB_USER=postgres.xxxxxxxxxxxxxxxxxxxx
DB_PASSWORD=
DB_HOST=aws-0-sa-east-1.pooler.supabase.com
DB_PORT=5432

# Segurança/produção.
# Desenvolvimento local: mantenha DEBUG=True (sem ele o sistema sobe em modo
# produção e exige SECRET_KEY e HTTPS). SECRET_KEY e ALLOWED_HOSTS podem
# ficar em branco no local.
# Produção: DEBUG=False, SECRET_KEY obrigatória (gere com
#   python -c "import secrets; print(secrets.token_urlsafe(50))")
# e o(s) domínio(s) reais em ALLOWED_HOSTS. Sem SECRET_KEY o backend se
# recusa a subir.
SECRET_KEY=
DEBUG=True
ALLOWED_HOSTS=
CORS_ALLOWED_ORIGINS=http://localhost:3000

# URL pública do frontend — usada para montar o link enviado por e-mail
# na redefinição de senha ("esqueci minha senha").
FRONTEND_URL=http://localhost:3000

# DataJud (CNJ) — consulta automática de processos.
# A chave é pública e divulgada pelo próprio CNJ em
# https://datajud-wiki.cnj.jus.br/api-publica/acesso
# Sem ela, a consulta é recusada com uma mensagem explicando o que falta.
DATAJUD_API_KEY=

# DJEN (intimações) — consulta pública, sem chave. Só preencha para apontar
# a outro endereço (ex.: servidor de teste).
DJEN_API_URL=

# Notificações push no celular/navegador. Gere com:
#   python manage.py gerar_chaves_vapid
# VAPID_EMAIL é o contato que os serviços de push (Google, Apple, Mozilla)
# usam se precisarem falar com o responsável pelo sistema.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_EMAIL=

# OpenAI — usado pelo assistente de IA (opcional em dev)
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini

# E-mail — sem estas variáveis, e-mails são só impressos no console
# (backend "console"), útil em desenvolvimento.
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=

# Planos: e-mail de quem atende quem quer contratar um plano pago (botão
# "Quero este plano"). Em branco, a tela orienta a falar com o administrador.
CONTATO_COMERCIAL=
